SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
# first Sunday of the month, 04:07 (Asia/Taipei) — quietest hour; renovate runs 19:00.
# :07, not :00 — ci-disk-gc runs every 20 min and its prune broke the 04:00 image pull (2026-10-04).
7 4 1-7 * * root [ "$(date +\%u)" = 7 ] && /usr/local/bin/jenkins-auto-upgrade.sh >/dev/null 2>&1
