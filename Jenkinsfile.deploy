// devops-deploy-pipeline — GitOps-lite for the bluesea infra stack (2026-06-05).
//
// Watches arcana-devops main; when a merged change bumps an image TAG in a
// compose file, applies the same tag surgically to the deployed copies under
// /data/devops, pulls, recreates only the affected services, and verifies they
// come back. Major-version bumps and image-name changes are listed but left
// for a human (e.g. postgres 16->18 required dump/restore).
//
// Workflow-platform integration: any non-SUCCESS result here is picked up by
// the global B2 RunListener, which opens a ci-flow BPMN instance (AI Triage ->
// Build -> Fix -> Decide) on workflow.arcana.boo — no wiring needed in this file.
//
// Plan protocol: scripts/deploy/plan.py prints TSV (APPLY/SKIP lines) — parsed
// with core readFile; pipeline-utility-steps (readJSON) is not installed.

def planLines() {
    return readFile('plan.txt').split('\n').findAll { it.trim() }.collect { it.split('\t') }
}

pipeline {
    agent any
    options { disableConcurrentBuilds() }
    triggers { pollSCM('H/10 * * * *') }
    environment {
        // docker -v resolves bind sources on the HOST. $WORKSPACE is a path in
        // the jenkins container; its host-side location is under the
        // jenkins_home bind (/data/docker/volumes/devops_jenkins_home/_data).
        HOST_WS = "/data/docker/volumes/devops_jenkins_home/_data/workspace/${env.JOB_NAME}"
    }
    stages {
        stage('Plan') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$HOST_WS":/repo:ro \
                      -v /data/devops:/deployed:ro \
                      python:3.12-alpine \
                      python3 /repo/scripts/deploy/plan.py /repo /deployed > plan.txt
                    cat plan.txt || true
                '''
                script {
                    def rows = planLines()
                    // NOT .count{} — Groovy CPS silently mis-evaluates closure
                    // overloads of count (returned 0 for a non-empty plan, run #3)
                    env.APPLY_COUNT = rows.findAll { it[0] == 'APPLY' }.size().toString()
                    def skips = rows.findAll { it[0] == 'SKIP' }
                    if (skips) {
                        def manual = skips.collect { "${it[2]}: ${it[5]}" }.join('; ')
                        currentBuild.description = "manual needed → ${manual}"
                        echo "SKIPPED (human required): ${manual}"
                    }
                    if (env.APPLY_COUNT == '0') {
                        echo 'no auto-applicable tag changes — stack matches main'
                    }
                }
            }
        }
        stage('Apply') {
            when { expression { env.APPLY_COUNT != '0' } }
            steps {
                script {
                    for (row in planLines()) {
                        if (row[0] != 'APPLY') { continue }
                        def (FILE, SVC, FROM, TO) = [row[1], row[2], row[3], row[4]]
                        echo "deploy ${SVC}: ${FROM} -> ${TO} (${FILE})"
                        // helper mounts /data/devops at its HOST path so the compose
                        // file's relative binds still resolve to real host paths
                        sh """
                            docker run --rm \
                              -v /var/run/docker.sock:/var/run/docker.sock \
                              -v /data/devops:/data/devops -w /data/devops \
                              docker:cli sh -c '
                                sed -i "s|image: *${FROM}|image: ${TO}|" ${FILE} &&
                                docker compose -p devops -f ${FILE} pull -q ${SVC} &&
                                docker compose -p devops -f ${FILE} up -d --no-deps ${SVC}'
                        """
                    }
                }
            }
        }
        stage('Verify') {
            when { expression { env.APPLY_COUNT != '0' } }
            steps {
                script {
                    for (row in planLines()) {
                        if (row[0] != 'APPLY') { continue }
                        def SVC = row[2]
                        // container_name in this stack == service name
                        sh """
                            for i in \$(seq 1 30); do
                              sleep 10
                              ST=\$(docker inspect ${SVC} --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}' 2>/dev/null || echo gone)
                              echo "verify ${SVC}: \$ST"
                              case "\$ST" in
                                'running healthy'|'running -') exit 0 ;;
                                gone|*exited*) [ \$i -ge 3 ] && exit 1 ;;
                              esac
                            done
                            exit 1
                        """
                    }
                }
            }
        }
    }
    post {
        success {
            script {
                if (env.APPLY_COUNT != '0') {
                    echo "deployed ${env.APPLY_COUNT} service update(s) — stack now matches main"
                }
            }
        }
        // failure/unstable: the B2 global listener spawns a ci-flow instance automatically
    }
}
